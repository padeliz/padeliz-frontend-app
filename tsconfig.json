{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "paths": {
            "@/*": ["./*"],
            "@components/*": ["./components/*"],
            "@services/*": ["./services/*"],
            "@hooks/*": ["./hooks/*"],
            "@context/*": ["./context/*"],
            "@utils/*": ["./utils/*"],
            "@constants/*": ["./constants/*"],
            "@theme/*": ["./theme/*"],
            "@types/*": ["./types/*"],
            "@assets/*": ["./assets/*"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
