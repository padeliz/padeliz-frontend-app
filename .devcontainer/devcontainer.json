{
  "name": "Padeliz App (Expo)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "NODE_VERSION": "20"
    }
  },
  "runArgs": [
    "--name",
    "padeliz-frontend-app",
    "-p",
    "8081:8081",
    "-p",
    "8082:8082",
    "-p",
    "19000:19000",
    "-p",
    "19001:19001",
    "-p",
    "19002:19002",
    "-p",
    "19006:19006"
  ],
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "mounts": [
    "source=padeliz_app_node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume,volume-nocopy",
    "source=padeliz_app_expo,target=${containerWorkspaceFolder}/.expo,type=volume,volume-nocopy"
  ],
  "containerEnv": {
    "EXPO_USE_IPV6": "0",
    "EXPO_DEV_HOST": "host.docker.internal",
    "REACT_NATIVE_PACKAGER_HOSTNAME": "host.docker.internal",
    "WATCHPACK_POLLING": "true",
    "CI": "false"
  },
  "forwardPorts": [8081, 8082, 19000, 19001, 19002, 19006],
  "portsAttributes": {
    "8081": { "label": "Metro" },
    "8082": { "label": "RN Inspector" },
    "19000": { "label": "Expo DevTools" },
    "19001": { "label": "Expo WS" },
    "19002": { "label": "Expo (legacy)" },
    "19006": { "label": "Web" }
  },
  "postCreateCommand": "git config --global core.autocrlf true && git config --global core.filemode false && git config --global --add safe.directory /workspaces/padeliz-frontend-app && sudo chown -R node:node ${containerWorkspaceFolder}/node_modules ${containerWorkspaceFolder}/.expo || true && npm install --no-audit --no-fund",
  "postStartCommand": "sudo chown -R node:node ${containerWorkspaceFolder}/node_modules ${containerWorkspaceFolder}/.expo || true",
  "remoteUser": "node",
  "customizations": {
    "vscode": {
      "settings": {
        "typescript.tsdk": "node_modules/typescript/lib"
      },
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "msjsdiag.vscode-react-native"
      ]
    }
  }
}
