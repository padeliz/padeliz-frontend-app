# Google OAuth Client ID and Secret from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Generate yours at https://applekeygen.expo.app
APPLE_CLIENT_SECRET=

# Base URL and scheme for the app (change for production)
EXPO_PUBLIC_BASE_URL=http://localhost:8081
EXPO_PUBLIC_SCHEME=padeliz://

# Laravel API base. CORS on the backend only allows the app on http://localhost:8081,
# so the app must run on port 8081. Restart Metro after changing this value.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# JWT Secret and Refresh Secret to sign and verify tokens
JWT_SECRET=ZnI7fA9kLd5mX1yPq8tVb0UwHrZ4oYEX9gWcS3NjqMR2Teh5sBCYpQvJ7nGlKsdi
JWT_REFRESH_SECRET=expo_is_the_best_refresh
